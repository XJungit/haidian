  "localization_rules": [
    {
      "rule_id": "LOC-01",
      "name": "five-field node completeness",
      "required_fields": [
        "ai_off_path",
        "human_handoff",
        "gate_id",
        "operating_mode",
        "responsible_role"
      ],
      "violation_code": "MISSING_FIELD"
    },
    {
      "rule_id": "LOC-02",
      "name": "ai_off_path must not depend on the same system",
      "rejected_same_system_tokens": [
        "online",
        "线上",
        "app",
        "hotline? no"
      ],
      "note": "hotline is allowed as a human channel; rejected tokens target the same AI system. Upstream constraint: ai_off_path must not be a path that still depends on the same system."
    },
    {
      "rule_id": "LOC-03",
      "name": "gate binding per SEB ladder",
      "binding": {
        "L0": "G0",
        "L1": "G1",
        "L2": "G2",
        "L3": "G3",
        "L4": "G3"
      },
      "violation_code": "GATE_MISMATCH",
      "note": "L4 binds G3 per upstream l4_gate_rule; downgrade allowed with no extra procedural burden."
    },
    {
      "rule_id": "LOC-04",
      "name": "pilot-readiness eight-field ledger honesty gate",
      "ledger_file": "pilot-readiness-ledger.json",
      "required_fields": [
        "baseline_and_source",
        "observation_target_sample_window",
        "success_and_stop_conditions",
        "responsible_actor",
        "human_equivalent_service",
        "review_cycle",
        "retention_and_deletion_proof",
        "objection_appeal_channel"
      ],
      "allowed_status": [
        "known",
        "proposed",
        "unknown"
      ],
      "obligations": {
        "known": [
          "evidence"
        ],
        "proposed": [
          "confirm_by"
        ],
        "unknown": [
          "owner",
          "recompute_path"
        ]
      },
      "numeric_freeze_on_unknown": true,
      "violation_codes": [
        "LEDGER_MISSING_FIELD",
        "LEDGER_BAD_STATUS",
        "KNOWN_WITHOUT_EVIDENCE",
        "PROPOSED_WITHOUT_CONFIRMER",
        "UNKNOWN_NOT_FROZEN",
        "UNKNOWN_CARRIES_NUMBER"
      ],
      "note": "Freeze the field and name the responsible party when a baseline is missing, but never invent a number. Applies to the eight-field pilot-readiness contract raised by a maintainer in issue #1081."
    }
  ],
